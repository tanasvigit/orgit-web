<style>
  :root {
    --blue: #1f5fa8;
    --blue-dark: #154a86;
    --text: #111827;
    --muted: #6b7280;
    --line: #1f2937;
    --soft-line: #9ca3af;
    --bg-soft: #f3f4f6;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    line-height: 1.35;
    background: #ffffff;
  }

  /* A4 at 96dpi ≈ 794px × 1123px */
  .page {
    width: 794px;
    min-height: 1123px;
    margin: 0 auto;
    padding: 18px 18px 14px;
  }

  .top-header {
    display: block;
    margin-bottom: 10px;
  }
  .logo-wrap { display: flex; align-items: flex-start; gap: 10px; }
  .logo {
    width: 72px;
    height: 72px;
    border: 1px solid var(--soft-line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--muted);
    overflow: hidden;
    background: #fff;
    flex-shrink: 0;
  }
  .logo img { width: 100%; height: 100%; object-fit: contain; }
  .firm-info { flex: 1; min-width: 0; }
  .company-name { font-size: 14px; font-weight: 700; margin: 0 0 2px; }
  .company-meta { margin: 0; color: var(--muted); }
  .company-meta-line { margin: 0 0 4px; }

  .title-bar {
    background: var(--blue);
    color: #fff;
    padding: 8px 12px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-align: center;
    border: 1px solid var(--blue-dark);
    margin: 6px 0 10px;
  }

  .grid-form, .single-row, .data-table, .signatures {
    width: 100%;
    border-collapse: collapse;
  }
  .grid-form td,
  .single-row td,
  .data-table th,
  .data-table td,
  .signatures td {
    border: 1px solid var(--line);
    padding: 6px 8px;
    vertical-align: top;
  }
  .label { color: var(--muted); font-size: 11px; margin-bottom: 2px; }
  .value { font-weight: 700; min-height: 16px; word-break: break-word; }

  .section-title {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    padding: 6px 8px;
    font-weight: 700;
    margin: 10px 0 0;
  }

  table.data-table { table-layout: fixed; margin-bottom: 10px; }
  table.data-table th {
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    text-align: left;
  }
  table.data-table tr { break-inside: avoid; page-break-inside: avoid; }

  .w-sn { width: 44px; text-align: center; }
  .w-amt { width: 120px; text-align: right; white-space: nowrap; }
  .col-60 { width: 60%; }
  .col-40 { width: 40%; }

  .signatures td { padding: 10px 8px 28px; vertical-align: bottom; }
  .sign-label { font-size: 11px; color: var(--muted); margin-top: 16px; }
  .muted { color: var(--muted); }
  .mt-8 { margin-top: 8px; }

  .pay-lines {
    border: 1px solid var(--line);
    padding: 10px 10px 8px;
    margin-bottom: 10px;
  }
  .pay-line {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 8px;
    align-items: end;
    padding: 4px 0;
  }
  .pay-line .k {
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
  }
  .fill-line {
    display: inline-block;
    width: 100%;
    min-height: 18px;
    border-bottom: 1px solid #000;
    padding: 0 2px 1px;
    font-weight: 700;
  }
  .fill-line.short {
    width: 220px;
  }

  .journal-block {
    border: 1px solid var(--line);
    border-top: 0;
    padding: 10px 10px 6px;
  }
  .journal-title {
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
  }
  .journal-date {
    display: inline-block;
    min-width: 160px;
    border-bottom: 1px solid #000;
    padding: 0 2px 1px;
    font-weight: 700;
  }
  .je-line {
    display: grid;
    grid-template-columns: 1fr 90px 120px;
    gap: 10px;
    align-items: end;
    padding: 4px 0;
  }
  .je-line .to {
    font-weight: 700;
  }
  .je-field {
    border-bottom: 1px solid #000;
    min-height: 18px;
    padding: 0 2px 1px;
    font-weight: 700;
  }

  @media print {
    html, body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    table, tr, td, th { break-inside: avoid; page-break-inside: avoid; }
    thead { display: table-header-group; }
  }
</style>

<div class="page">
  <!-- Header: Logo | FIRM NAME, Address L1 | L2, City – Pincode | Phone | Email | GSTIN (from Entity Master) -->
  <div class="top-header">
    <div class="logo-wrap">
      <div class="logo">
        {{#if company_logo_data_uri}}
          <img src="{{company_logo_data_uri}}" alt="Logo" />
        {{else}}{{#if company_logo_url}}
          <img src="{{company_logo_url}}" alt="Logo" />
        {{/if}}{{/if}}
      </div>
      <div class="firm-info">
        <p class="company-name">{{company_name}}</p>
        <p class="company-meta company-meta-line">{{address_line1}}{{#if address_line2}} | {{address_line2}}{{/if}}</p>
        <p class="company-meta company-meta-line">{{city}}{{#if pincode}} – {{pincode}}{{/if}}{{#if company_phone}} | {{company_phone}}{{/if}}{{#if company_email}} | {{company_email}}{{/if}}{{#if company_gstin}} | {{company_gstin}}{{/if}}</p>
      </div>
    </div>
  </div>

  <div class="title-bar">PAYMENT VOUCHER</div>

  <table class="grid-form" aria-label="Voucher Details">
    <tr>
      <td>
        <div class="label">Voucher No</div>
        <div class="value">{{voucher_no}}</div>
      </td>
      <td>
        <div class="label">Voucher Date</div>
        <div class="value">{{voucher_date}}</div>
      </td>
    </tr>
    <tr>
      <td>
        <div class="label">Bill No</div>
        <div class="value">{{bill_no}}</div>
      </td>
      <td>
        <div class="label">Bill Date</div>
        <div class="value">{{bill_date}}</div>
      </td>
    </tr>
    <tr>
      <td>
        <div class="label">Payment Mode</div>
        <div class="value">{{payment_mode}}</div>
      </td>
      <td>
        <div class="label">Payment Date</div>
        <div class="value">{{payment_date}}</div>
      </td>
    </tr>
    <tr>
      <td>
        <div class="label">Paid Through</div>
        <div class="value">{{paid_through}}</div>
      </td>
      <td>
        <div class="label">Cheque / UTR No</div>
        <div class="value">{{cheque_utr_no}}</div>
      </td>
    </tr>
  </table>

  <div class="pay-lines" aria-label="Payee and Amount">
    <div class="pay-line">
      <div class="k">Paid To:</div>
      <div class="fill-line">{{paid_to}}</div>
    </div>
    <div class="pay-line">
      <div class="k">Amount (Rs.):</div>
      <div class="fill-line short">{{amount}}</div>
    </div>
    <div class="pay-line">
      <div class="k">Amount in Words:</div>
      <div class="fill-line">{{amount_words}}</div>
    </div>
  </div>

  <div class="section-title">Expense Details</div>
  <table class="data-table" aria-label="Expense Details Table">
    <thead>
      <tr>
        <th class="w-sn">S.No</th>
        <th>Particulars</th>
        <th>Ledger Account</th>
        <th class="w-amt">Amount (Rs)</th>
      </tr>
    </thead>
    <tbody>
      {{#each expense_rows}}
        <tr>
          <td class="w-sn">{{inc @index}}</td>
          <td>{{particulars}}</td>
          <td>{{ledgerAccount}}</td>
          <td class="w-amt">{{amount}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="section-title">Journal Entries</div>
  <div class="journal-block" aria-label="Journal Entries">
    <div class="journal-title">
      Due Entry (Date: <span class="journal-date">{{due_entry_date}}</span>)
    </div>
    {{#each due_entries}}
      <div class="je-line">
        <div class="je-field">{{#if isTo}}To {{/if}}{{accountName}}</div>
        <div class="je-field">{{drCr}}</div>
        <div class="je-field">{{amount}}</div>
      </div>
    {{/each}}

    <div style="height: 8px"></div>

    <div class="journal-title">
      Payment Entry (Date: <span class="journal-date">{{payment_entry_date}}</span>)
    </div>
    {{#each payment_entries}}
      <div class="je-line">
        <div class="je-field">{{#if isTo}}To {{/if}}{{accountName}}</div>
        <div class="je-field">{{drCr}}</div>
        <div class="je-field">{{amount}}</div>
      </div>
    {{/each}}
  </div>

  <table class="signatures" aria-label="Signatures">
    <tr>
      <td>
        <div class="value">{{prepared_by}}</div>
        <div class="sign-label">Prepared By</div>
      </td>
      <td>
        <div class="value">{{checked_by}}</div>
        <div class="sign-label">Checked By</div>
      </td>
      <td>
        <div class="value">{{approved_by}}</div>
        <div class="sign-label">Approved By</div>
      </td>
      <td>
        <div class="value">{{payee_signature}}</div>
        <div class="sign-label">Signature of Payee</div>
      </td>
    </tr>
  </table>

  <p class="muted mt-8">This is a computer-generated document.</p>
</div>

